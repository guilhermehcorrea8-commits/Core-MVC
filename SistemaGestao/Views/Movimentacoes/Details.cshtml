@model SistemaGestao.Models.Movimentacao

@{
    ViewData["Title"] = "Detalhes da Movimentação";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold">Detalhes da Movimentação</h1>
            <p class="text-muted">
                Informações do lançamento financeiro.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            Voltar
        </a>

    </div>

    <div class="card shadow-sm">

        <div class="card-body p-4">

            <dl class="row mb-0">

                <dt class="col-sm-3">
                    Tipo
                </dt>

                <dd class="col-sm-9">
                    @if (Model.Tipo == "Entrada")
                    {
                        <span class="badge bg-success">
                            Entrada
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger">
                            Saída
                        </span>
                    }
                </dd>

                <dt class="col-sm-3">
                    Valor
                </dt>

                <dd class="col-sm-9 fw-bold
                    @(Model.Tipo == "Entrada"
                                                                ? "text-success"
                                                                : "text-danger")">

                    @Model.Valor.ToString("C")
                </dd>

                <dt class="col-sm-3">
                    Data
                </dt>

                <dd class="col-sm-9">
                    @Model.Data.ToString("dd/MM/yyyy")
                </dd>

                <dt class="col-sm-3">
                    Conta
                </dt>

                <dd class="col-sm-9">
                    @(Model.Conta?.Nome ?? "Conta não encontrada")
                </dd>

                <dt class="col-sm-3">
                    Descrição
                </dt>

                <dd class="col-sm-9">
                    @(string.IsNullOrWhiteSpace(Model.Descricao)
                                        ? "Sem descrição"
                                        : Model.Descricao)
                </dd>

            </dl>

            <hr />

            <div class="d-flex gap-2">

                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                    Editar
                </a>

                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                    Excluir
                </a>

            </div>

        </div>

    </div>

</div>