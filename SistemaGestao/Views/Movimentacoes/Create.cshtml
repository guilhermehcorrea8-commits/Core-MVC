@model SistemaGestao.Models.Movimentacao

@{
    ViewData["Title"] = "Nova Movimentação";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">Nova Movimentação</h3>
        </div>

        <div class="card-body">
            <form asp-action="Create">

                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="mb-3">
                    <label asp-for="Tipo" class="form-label"></label>

                    <select asp-for="Tipo" class="form-select">
                        <option value="">Selecione o tipo</option>
                        <option value="Entrada">Entrada</option>
                        <option value="Saída">Saída</option>
                    </select>

                    <span asp-validation-for="Tipo" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Valor" class="form-label"></label>

                    <div class="input-group">
                        <span class="input-group-text">R$</span>
                        <input asp-for="Valor" class="form-control" type="number" step="0.01" min="0.01" />
                    </div>

                    <span asp-validation-for="Valor" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Data" class="form-label"></label>

                    <input asp-for="Data" class="form-control" type="date" />

                    <span asp-validation-for="Data" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Descricao" class="form-label"></label>

                    <input asp-for="Descricao" class="form-control"
                        placeholder="Ex.: Salário, compra, transferência..." />

                    <span asp-validation-for="Descricao" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ContaId" class="form-label"></label>

                    <select asp-for="ContaId" class="form-select" asp-items="ViewBag.ContaId">
                        <option value="">Selecione uma conta</option>
                    </select>

                    <span asp-validation-for="ContaId" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Registrar movimentação
                    </button>

                    <a asp-action="Index" class="btn btn-secondary">
                        Voltar
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}