@model SistemaGestao.Models.Movimentacao

@{
    ViewData["Title"] = "Excluir Movimentação";
}

<div class="container py-4">

    <h1 class="fw-bold">Excluir Movimentação</h1>

    <div class="alert alert-warning mt-3">
        Tem certeza que deseja excluir esta movimentação?
        O saldo da conta será corrigido automaticamente.
    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <dl class="row">

                <dt class="col-sm-3">
                    Tipo
                </dt>

                <dd class="col-sm-9">
                    @Model.Tipo
                </dd>

                <dt class="col-sm-3">
                    Valor
                </dt>

                <dd class="col-sm-9 fw-bold">
                    @Model.Valor.ToString("C")
                </dd>

                <dt class="col-sm-3">
                    Data
                </dt>

                <dd class="col-sm-9">
                    @Model.Data.ToString("dd/MM/yyyy")
                </dd>

                <dt class="col-sm-3">
                    Conta
                </dt>

                <dd class="col-sm-9">
                    @(Model.Conta?.Nome ?? "Conta não encontrada")
                </dd>

                <dt class="col-sm-3">
                    Descrição
                </dt>

                <dd class="col-sm-9">
                    @(string.IsNullOrWhiteSpace(Model.Descricao)
                                        ? "Sem descrição"
                                        : Model.Descricao)
                </dd>

            </dl>

            <form asp-action="Delete">

                <input type="hidden" asp-for="Id" />

                <button type="submit" class="btn btn-danger">
                    Confirmar exclusão
                </button>

                <a asp-action="Index" class="btn btn-outline-secondary">
                    Cancelar
                </a>

            </form>

        </div>

    </div>

</div>