@{
    ViewData["Title"] = "Dashboard";

    var movimentacoes = ViewBag.Movimentacoes
        as List<SistemaGestao.Models.Movimentacao>
        ?? new List<SistemaGestao.Models.Movimentacao>();

    var contas = ViewBag.Contas
        as IEnumerable<dynamic>
        ?? new List<dynamic>();

    var metas = ViewBag.Metas
        as IEnumerable<dynamic>
        ?? new List<dynamic>();

    decimal saldoTotal = ViewBag.SaldoTotal != null
        ? (decimal)ViewBag.SaldoTotal
        : 0m;

    decimal totalEntradas = ViewBag.TotalEntradas != null
        ? (decimal)ViewBag.TotalEntradas
        : 0m;

    decimal totalSaidas = ViewBag.TotalSaidas != null
        ? (decimal)ViewBag.TotalSaidas
        : 0m;

    int totalContas = ViewBag.TotalContas != null
        ? (int)ViewBag.TotalContas
        : 0;

    decimal valorObjetivo = 0m;
    decimal valorAtual = 0m;
    int totalMetas = 0;

    foreach (var meta in metas)
    {
        totalMetas++;

        if (meta.ValorObjetivo != null)
            valorObjetivo += (decimal)meta.ValorObjetivo;

        if (meta.ValorAtual != null)
            valorAtual += (decimal)meta.ValorAtual;
    }

    decimal percentualMeta = valorObjetivo > 0
        ? (valorAtual / valorObjetivo) * 100
        : 0;

    if (percentualMeta > 100)
        percentualMeta = 100;

    decimal patrimonio = saldoTotal;
}

<div class="dashboard-container">

    <!-- CABEÇALHO -->
    <div class="dashboard-header">
        <h1>Dashboard</h1>

        <p>
            Visão geral da sua gestão financeira
        </p>
    </div>


    <!-- CARDS PRINCIPAIS -->
    <div class="dashboard-cards">

        <!-- SALDO -->
        <div class="dashboard-card">

            <span class="card-label">
                Saldo disponível
            </span>

            <h2 class="valor saldo">
                @saldoTotal.ToString("C")
            </h2>

            <small>
                Receitas - Despesas
            </small>

        </div>


        <!-- RECEITAS -->
        <div class="dashboard-card">

            <span class="card-label">
                Receitas
            </span>

            <h2 class="valor receitas">
                @totalEntradas.ToString("C")
            </h2>

            <small>
                Total registrado
            </small>

        </div>


        <!-- DESPESAS -->
        <div class="dashboard-card">

            <span class="card-label">
                Despesas
            </span>

            <h2 class="valor despesas">
                @totalSaidas.ToString("C")
            </h2>

            <small>
                Total registrado
            </small>

        </div>


        <!-- CONTAS -->
        <div class="dashboard-card">

            <span class="card-label">
                Contas ativas
            </span>

            <h2 class="valor contas">
                @totalContas
            </h2>

            <small>
                Contas cadastradas
            </small>

        </div>

    </div>


    <!-- SEGUNDA LINHA -->
    <div class="dashboard-row">


        <!-- METAS -->
        <div class="dashboard-section">

            <div class="section-header">
                🎯 <strong>Metas financeiras</strong>
            </div>

            <div class="section-body">

                <div class="meta-info">

                    <span>
                        Economizado
                    </span>

                    <strong>
                        @valorAtual.ToString("C")
                    </strong>

                </div>


                <div class="progress-container">

                    <div class="progress-bar"
                         style="width:@percentualMeta.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%">

                        @percentualMeta.ToString("0.#")%

                    </div>

                </div>


                <div class="meta-info objetivo">

                    <span>
                        Objetivo:
                    </span>

                    <strong>
                        @valorObjetivo.ToString("C")
                    </strong>

                </div>


                <div class="meta-footer">

                    <strong>
                        @totalMetas
                    </strong>

                    meta(s) cadastrada(s)

                </div>

            </div>

        </div>


        <!-- PATRIMÔNIO -->
        <div class="dashboard-section">

            <div class="section-header">
                🏛️ <strong>Patrimônio nas contas</strong>
            </div>

            <div class="section-body patrimonio">

                <h2>
                    @patrimonio.ToString("C")
                </h2>

                <p>
                    Soma dos saldos das contas ativas.
                </p>

                <a asp-controller="Contas"
                   asp-action="Index"
                   class="btn-dashboard">

                    Gerenciar contas

                </a>

            </div>

        </div>

    </div>


    <!-- ÚLTIMAS MOVIMENTAÇÕES -->
    <div class="dashboard-section movimentacoes">

        <div class="section-header">
            📋 <strong>Últimas movimentações</strong>
        </div>


        <div class="section-body">

            @if (!movimentacoes.Any())
            {
                <div class="empty-message">
                    Nenhuma movimentação cadastrada.
                </div>
            }
            else
            {

                <div class="table-responsive">

                    <table class="dashboard-table">

                        <thead>

                            <tr>

                                <th>Data</th>

                                <th>Tipo</th>

                                <th>Descrição</th>

                                <th>Conta</th>

                                <th>Valor</th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var movimentacao in movimentacoes)
                            {

                                <tr>

                                    <td>
                                        @movimentacao.Data.ToString("dd/MM/yyyy")
                                    </td>


                                    <td>

                                        @if (movimentacao.Tipo == "Entrada")
                                        {
                                            <span class="badge entrada">
                                                Entrada
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge saida">
                                                Saída
                                            </span>
                                        }

                                    </td>


                                    <td>
                                        @movimentacao.Descricao
                                    </td>


                                    <td>
                                        @(movimentacao.Conta?.Nome ?? "Não informado")
                                    </td>


                                    <td class="valor-tabela">

                                        @movimentacao.Valor.ToString("C")

                                    </td>

                                </tr>

                            }

                        </tbody>

                    </table>

                </div>

            }

        </div>

    </div>

</div>